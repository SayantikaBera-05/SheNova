# ==============================================================================
# GlowGram Production & Development Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings -> Environment Variables.
# DO NOT COMMIT REAL KEYS OR SECRETS TO GIT.
# ==============================================================================

# AI Provider API Keys (Server-side only — set at least one for production)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Spotify API Credentials (Client Credentials Flow — optional server-side integration)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public Application Settings (Client & Server)
NEXT_PUBLIC_APP_NAME=GlowGram
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
NEXT_PUBLIC_MAX_FILES=10

# External Demo Video URL (Optional: Cloudinary / Vercel Blob / S3 MP4 URL for production)
NEXT_PUBLIC_DEMO_VIDEO_URL=
